{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/626Labs-LLC/sanduhr-widgets/schema/effects.schema.json",
  "title": "Sanduhr effects pack: effects.json (format v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "effects"],
  "properties": {
    "schema_version": { "const": 1 },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "intensity", "period_ms", "color"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,23}$" },
          "type": { "enum": ["glow", "sweep", "shimmer", "pulse"] },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "period_ms": { "type": "integer", "minimum": 400, "maximum": 10000 },
          "color": {
            "description": "A #rrggbb color, or the literal ink for the active theme's text color.",
            "anyOf": [
              { "const": "ink" },
              { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            ]
          }
        }
      }
    }
  }
}
