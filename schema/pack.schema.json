{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/626Labs-LLC/sanduhr-widgets/schema/pack.schema.json",
  "title": "Sanduhr widget pack manifest (format v1)",
  "description": "pack.json. Restates docs/FORMAT.md section 2. The validator in tools/validate.py is authoritative for rules JSON Schema cannot express (file listing, license text, trademark scan).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "author", "license", "kind", "sanduhr_min", "description", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": {
      "enum": ["MIT", "CC-BY-4.0", "CC0-1.0", "Apache-2.0", "OFL-1.1", "BSD-3-Clause", "ISC"]
    },
    "kind": { "enum": ["theme", "palette", "effects", "font", "sprite"] },
    "sanduhr_min": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "preview": { "$ref": "#/$defs/path" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "font" } }, "required": ["kind"] },
      "then": { "properties": { "license": { "enum": ["OFL-1.1", "Apache-2.0"] } } }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    }
  }
}
